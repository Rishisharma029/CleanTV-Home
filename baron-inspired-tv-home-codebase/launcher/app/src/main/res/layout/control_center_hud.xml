<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/controlCenterRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="false">

    <!-- Dim Scrim Backdrop (Click to dismiss) -->
    <View
        android:id="@+id/controlCenterScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="false" />

    <!-- Frosted Glass Slide-Out Panel -->
    <LinearLayout
        android:id="@+id/controlCenterPanel"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:layout_gravity="end|top"
        android:background="@drawable/control_center_panel_bg"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- Top Header & Clock -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_control_center"
                android:tint="#FFFFFFFF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="Control Center"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/ccClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:textColor="#A0FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/ccSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginStart="36dp"
            android:text="CleanTV · Quick HUD"
            android:textColor="#66FFFFFF"
            android:textSize="11sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Section: Quick Connectivity Toggles -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="CONNECTIVITY &amp; SYSTEM"
                    android:textColor="#88FFFFFF"
                    android:textSize="10sp"
                    android:letterSpacing="0.08" />

                <!-- 2-Column Grid Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Wi-Fi Card -->
                    <LinearLayout
                        android:id="@+id/cardWifi"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:background="@drawable/glass_panel"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/ccWifiIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_wifi"
                            android:tint="#FF38BDF8" />

                        <TextView
                            android:id="@+id/ccWifiTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:text="Wi-Fi"
                            android:textColor="#FFFFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/ccWifiStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Connected"
                            android:textColor="#99FFFFFF"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="wrap_content" />

                    <!-- Bluetooth Card -->
                    <LinearLayout
                        android:id="@+id/cardBluetooth"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:background="@drawable/glass_panel"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_bluetooth"
                            android:tint="#FF818CF8" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:text="Bluetooth"
                            android:textColor="#FFFFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/ccBluetoothStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Accessories"
                            android:textColor="#99FFFFFF"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 2-Column Grid Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <!-- Sleep Timer Card -->
                    <LinearLayout
                        android:id="@+id/cardSleepTimer"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:background="@drawable/glass_panel"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_timer"
                            android:tint="#FFFBBF24" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:text="Sleep Timer"
                            android:textColor="#FFFFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/ccSleepTimerStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Off"
                            android:textColor="#99FFFFFF"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="wrap_content" />

                    <!-- Display / Night Mood Card -->
                    <LinearLayout
                        android:id="@+id/cardDisplay"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:background="@drawable/glass_panel"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_picture"
                            android:tint="#FF34D399" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:text="Display Mood"
                            android:textColor="#FFFFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/ccDisplayStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Vibrant Cinema"
                            android:textColor="#99FFFFFF"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 2-Column Grid Row 3: Game Mode & Network Speed Meter -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <!-- Game Mode Card (ALLM & MEMC Off) -->
                    <LinearLayout
                        android:id="@+id/cardGameMode"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:background="@drawable/glass_panel"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/ccGameIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_gamepad"
                            android:tint="#FFF59E0B" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:text="Game Mode"
                            android:textColor="#FFFFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/ccGameModeStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="ALLM · Off"
                            android:textColor="#99FFFFFF"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="wrap_content" />

                    <!-- Network Speed Meter Card -->
                    <LinearLayout
                        android:id="@+id/cardSpeedMeter"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:background="@drawable/glass_panel"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/ccSpeedIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_speedometer"
                            android:tint="#FF06B6D4" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:text="Speed Meter"
                            android:textColor="#FFFFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/ccSpeedStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Tap to test"
                            android:textColor="#99FFFFFF"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Section: Audio Output Quick-Switch -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="AUDIO OUTPUT QUICK-SWITCH"
                    android:textColor="#88FFFFFF"
                    android:textSize="10sp"
                    android:letterSpacing="0.08" />

                <LinearLayout
                    android:id="@+id/ccAudioOutputContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- TV Speakers Pill -->
                    <LinearLayout
                        android:id="@+id/btnAudioTvSpeakers"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/glass_panel"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <ImageView
                            android:id="@+id/iconAudioTvSpeakers"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_speaker"
                            android:tint="#FFA78BFA" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TV Speakers"
                                android:textColor="#FFFFFFFF"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:id="@+id/subAudioTvSpeakers"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Internal Built-In Audio"
                                android:textColor="#88FFFFFF"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/badgeAudioTvSpeakers"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="● ACTIVE"
                            android:textColor="#FF34D399"
                            android:textSize="9sp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.08" />
                    </LinearLayout>

                    <!-- Soundbar (eARC/Optical) Pill -->
                    <LinearLayout
                        android:id="@+id/btnAudioSoundbar"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/glass_panel"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <ImageView
                            android:id="@+id/iconAudioSoundbar"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_soundbar"
                            android:tint="#FF38BDF8" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Soundbar"
                                android:textColor="#FFFFFFFF"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:id="@+id/subAudioSoundbar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="eARC / Optical Output"
                                android:textColor="#88FFFFFF"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/badgeAudioSoundbar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#FF34D399"
                            android:textSize="9sp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.08" />
                    </LinearLayout>

                    <!-- Bluetooth Headphones Pill -->
                    <LinearLayout
                        android:id="@+id/btnAudioBluetooth"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/glass_panel"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <ImageView
                            android:id="@+id/iconAudioBluetooth"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_headphones"
                            android:tint="#FFF472B6" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bluetooth Headphones"
                                android:textColor="#FFFFFFFF"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:id="@+id/subAudioBluetooth"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Wireless Audio"
                                android:textColor="#88FFFFFF"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/badgeAudioBluetooth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#FF34D399"
                            android:textSize="9sp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.08" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Section: Live Inputs Quick Switch -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="CONNECTED INPUTS"
                    android:textColor="#88FFFFFF"
                    android:textSize="10sp"
                    android:letterSpacing="0.08" />

                <LinearLayout
                    android:id="@+id/ccInputsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Section: Memory & Device Performance -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="DEVICE PERFORMANCE"
                    android:textColor="#88FFFFFF"
                    android:textSize="10sp"
                    android:letterSpacing="0.08" />

                <LinearLayout
                    android:id="@+id/cardBoostRam"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/glass_panel"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_storage"
                        android:tint="#FF10B981" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/ccRamTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="RAM &amp; Memory Booster"
                            android:textColor="#FFFFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/ccRamStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Checking memory..."
                            android:textColor="#99FFFFFF"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/ccBoostBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#22FFFFFF"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="CLEAN"
                        android:textColor="#FF6EE7B7"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Section: Settings Shortcuts -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="SETTINGS SHORTCUTS"
                    android:textColor="#88FFFFFF"
                    android:textSize="10sp"
                    android:letterSpacing="0.08" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Launcher Settings -->
                    <LinearLayout
                        android:id="@+id/btnCcLauncherSettings"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/glass_panel"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_home_settings"
                            android:tint="#FFFFFFFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="CleanTV"
                            android:textColor="#FFFFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="wrap_content" />

                    <!-- Android TV Settings -->
                    <LinearLayout
                        android:id="@+id/btnCcSystemSettings"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/glass_panel"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_settings"
                            android:tint="#FFFFFFFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="System"
                            android:textColor="#FFFFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Section: Mobile Web Remote & Setup (Scan QR Code) -->
                <LinearLayout
                    android:id="@+id/cardWebRemote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/glass_panel"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="#FFFFFFFF"
                        android:padding="2dp">

                        <ImageView
                            android:id="@+id/ccQrThumbnail"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_qr_code" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mobile Web Remote"
                            android:textColor="#FFFFFFFF"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/ccQrUrlStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Scan QR code with phone camera"
                            android:textColor="#99FFFFFF"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SCAN"
                        android:textColor="#FF38BDF8"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.08" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>
</FrameLayout>
