<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D9090D16"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="760dp"
        android:layout_height="520dp"
        android:layout_gravity="center"
        android:background="@drawable/glass_panel"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_clean"
                android:tint="#FFEF4444" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Universal TV Auto-Debloater"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvDebloaterDeviceSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Detecting TV hardware &amp; OEM packages..."
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Action buttons in header -->
            <Button
                android:id="@+id/btnAutoDebloat"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/pill_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="⚡ Auto-Debloat"
                android:textColor="@drawable/pill_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRestoreAll"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/pill_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="↩ Restore"
                android:textColor="@drawable/pill_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCloseDebloater"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/pill_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Close"
                android:textColor="@drawable/pill_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Safe Preview & Metrics Bar -->
        <LinearLayout
            android:id="@+id/layoutSafePreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#18FFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDebloaterStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scanning 150+ OEM bloat signatures..."
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDebloaterSavings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Estimated RAM Savings: ~180MB RAM • 48 CPU Wakeups/Hr Saved"
                    android:textColor="#34D399"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDebloaterBrandBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#22EF4444"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="BRAND: DETECTED"
                android:textColor="#FFEF4444"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Divider line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="#1AFFFFFF" />

        <!-- Debloat Items List inside ScrollView -->
        <ScrollView
            android:id="@+id/debloatScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fadeScrollbars="false"
            android:focusable="false">

            <LinearLayout
                android:id="@+id/debloatListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

    </LinearLayout>
</FrameLayout>
