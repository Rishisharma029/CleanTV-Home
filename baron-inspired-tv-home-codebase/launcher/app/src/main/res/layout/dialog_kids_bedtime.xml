<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bedtimeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FA0B0F19"
    android:clickable="true"
    android:focusable="false">

    <LinearLayout
        android:layout_width="540dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/glass_panel"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌙"
            android:textSize="54sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Bedtime! Screen Limit Reached"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Today's TV screen time is all done! Time to brush teeth, read a story, and dream of stars 🌟"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp"
            android:gravity="center"
            android:lineSpacingExtra="3dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBedtimeUnlock"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/pill_bg"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Parent Unlock"
                android:textColor="@drawable/pill_text"
                android:textSize="13sp"
                android:textStyle="bold"
                android:focusable="true"
                android:clickable="true" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
