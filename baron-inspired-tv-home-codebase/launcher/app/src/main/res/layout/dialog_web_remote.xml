<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qrDialogRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D0000000"
    android:clickable="true"
    android:focusable="false">

    <LinearLayout
        android:id="@+id/qrCardContent"
        android:layout_width="480dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/glass_panel"
        android:orientation="vertical"
        android:padding="26dp"
        android:clickable="true"
        android:focusable="false"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/qrModeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="⚡ CleanTV Remote Hub"
            android:textColor="#FF38BDF8"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/qrTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Mobile Web Remote"
            android:textColor="#FFFFFFFF"
            android:textSize="21sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/qrSubtitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Scan with your phone camera · No app needed"
            android:textColor="#99FFFFFF"
            android:textSize="12sp" />

        <FrameLayout
            android:layout_width="210dp"
            android:layout_height="210dp"
            android:layout_marginTop="16dp"
            android:background="#FFFFFFFF"
            android:padding="8dp">

            <ImageView
                android:id="@+id/qrCodeImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <TextView
            android:id="@+id/qrUrlText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/pill_bg"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="http://192.168.1.100:8080"
            android:textColor="#FF38BDF8"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/qrPcUrlText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/glass_panel"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="PC Browser: http://localhost:8080"
            android:textColor="#FFA7F3D0"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/qrHintText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Fast virtual keyboard typing, D-pad, and TV setup"
            android:textColor="#88FFFFFF"
            android:textSize="11sp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnCloseQr"
            android:layout_width="160dp"
            android:layout_height="44dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/pill_bg"
            android:text="Done"
            android:textColor="@drawable/pill_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusUp="@id/btnCloseQr"
            android:nextFocusDown="@id/btnCloseQr"
            android:nextFocusLeft="@id/btnCloseQr"
            android:nextFocusRight="@id/btnCloseQr" />
    </LinearLayout>
</FrameLayout>
